# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trusta?schema=public"

# Where the web app runs (CORS, origin checks, links in emails)
APP_URL=http://localhost:5173
# Extra comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Sessions
SESSION_TTL_DAYS=30
# Defaults to true when NODE_ENV=production. Must be true behind HTTPS.
# COOKIE_SECURE=true

# Number of reverse proxies in front of the API (e.g. 1 behind a load balancer)
TRUST_PROXY=0

# Image uploads (local disk)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
